{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Employee Pulse Weekly Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "person_id",
    "full_name",
    "role_type",
    "week_start_date",
    "workload_score",
    "clarity_gap_score",
    "collaboration_friction_score",
    "resource_gap_score",
    "risk_level",
    "short_summary",
    "manager_suggestions",
    "confidence_note"
  ],
  "properties": {
    "person_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "full_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "role_type": {
      "type": "string",
      "enum": ["qc_manager", "performance_bridge", "set_operations"]
    },
    "week_start_date": {
      "type": "string",
      "format": "date"
    },
    "workload_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "clarity_gap_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "collaboration_friction_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "resource_gap_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "short_summary": {
      "type": "string",
      "minLength": 5,
      "maxLength": 800
    },
    "manager_suggestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 300
      }
    },
    "confidence_note": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    }
  }
}
